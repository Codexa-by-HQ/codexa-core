{
	"name": "@codexa/core",
	"version": "1.0.9",
	"license": "MIT",
	"description": "Enterprise-grade modular toolkit for Deno - plugin-first HTTP, event bus, store, cache, type-safe env, MongoDB, Redis, storage, and more.",
	"author": "Hamza Qureshi",
	"repository": {
		"type": "git",
		"author": "Codexa-by-HQ",
		"url": "https://github.com/Codexa-by-HQ/codexa-core.git"
	},
	"keywords": [
		"deno",
		"framework",
		"backend",
		"api",
		"http",
		"rou3",
		"plugin-first",
		"middleware",
		"mongodb",
		"redis",
		"cache",
		"event-bus",
		"pubsub",
		"store",
		"zod",
		"env",
		"modular",
		"enterprise",
		"codexa",
		"typescript"
	],
	"exports": {
		".": "./mod.js",
		"./http": "./src/lib/http/mod.js",
		"./openapi": "./src/lib/openapi/mod.js",
		"./sdk": "./src/lib/sdk/mod.js",
		"./config": "./src/config/mod.js",
		"./bus": "./src/lib/bus/mod.js",
		"./store": "./src/lib/store/mod.js",
		"./cache": "./src/lib/cache/mod.js",
		"./storage": "./src/lib/storage/mod.js",
		"./providers": "./src/providers/mod.js",
		"./providers/path": "./src/providers/path.js",
		"./providers/zod": "./src/providers/zod.js",
		"./providers/dotenv": "./src/providers/dotenv.js",
		"./providers/ioredis": "./src/providers/ioredis.js",
		"./providers/mongodb": "./src/providers/mongodb.js",
		"./providers/qs": "./src/providers/qs.js",
		"./providers/rou3": "./src/providers/rou3.js",
		"./providers/ua-parser-js": "./src/providers/ua-parser-js.js",
		"./providers/noble-hashes": "./src/providers/noble-hashes.js",
		"./logger": "./src/utils/logger.js",
		"./zod": "./src/providers/zod.js",
		"./crypto": "./src/utils/crypto.js",
		"./hash": "./src/utils/hash.js",
		"./device": "./src/utils/device.js",
		"./ttl": "./src/utils/ttl.js",
		"./response": "./src/utils/response.js",
		"./query": "./src/utils/parseQueryParams.js",
		"./cli": "./src/cli/main.js"
	},
	"imports": {
		"@std/path": "jsr:@std/path@^1.1.6",
		"@zod/zod": "jsr:@zod/zod@^4.6.5",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.8",
		"ioredis": "npm:ioredis@^6.0.0",
		"mongodb": "npm:mongodb@^7.7.0",
		"qs": "npm:qs@^6.16.0",
		"rou3": "npm:rou3@^1.0.0",
		"ua-parser-js": "npm:ua-parser-js@^2.0.10",
		"@noble/hashes": "npm:@noble/hashes@2.4.0"
	},
	"compilerOptions": {
		"lib": [
			"deno.window",
			"deno.unstable"
		],
		"strict": true
	},
	"tasks": {
		"check": "deno check --no-lock ./mod.js ./src/lib/http/mod.js ./src/lib/openapi/mod.js ./src/lib/sdk/mod.js ./src/config/mod.js ./src/lib/bus/mod.js ./src/lib/store/mod.js ./src/lib/cache/mod.js ./src/lib/storage/mod.js ./src/providers/mod.js ./src/providers/path.js ./src/providers/zod.js ./src/providers/dotenv.js ./src/providers/ioredis.js ./src/providers/mongodb.js ./src/providers/qs.js ./src/providers/rou3.js ./src/providers/ua-parser-js.js ./src/providers/noble-hashes.js ./src/utils/logger.js ./src/utils/crypto.js ./src/utils/hash.js ./src/utils/device.js ./src/utils/ttl.js ./src/utils/response.js ./src/utils/parseQueryParams.js ./src/cli/main.js",
		"dry-run": "deno publish --no-lock --dry-run --allow-dirty",
		"publish": "deno publish --no-lock"
	},
	"publish": {
		"exclude": [
			"!**"
		],
		"include": [
			"**/*.js",
			"**/*.d.ts",
			"deno.json",
			"README.md",
			"LICENSE",
			"env.example.txt"
		]
	}
}
