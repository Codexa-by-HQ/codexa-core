{
	"name": "@codexa/core",
	"version": "1.1.2",
	"license": "MIT",
	"description": "Enterprise-grade modular toolkit for Deno - plugin-first HTTP, event bus, store, cache, type-safe env, MongoDB, Redis, storage, and more.",
	"author": "Hamza Qureshi",
	"repository": {
		"type": "git",
		"author": "Codexa-by-HQ",
		"url": "https://github.com/Codexa-by-HQ/codexa-core.git"
	},
	"keywords": [
		"deno",
		"framework",
		"backend",
		"api",
		"http",
		"jetrouter",
		"plugin-first",
		"middleware",
		"mongodb",
		"redis",
		"cache",
		"event-bus",
		"pubsub",
		"store",
		"zod",
		"env",
		"modular",
		"enterprise",
		"codexa",
		"typescript",
		"toolkit"
	],
	"exports": {
		".": "./mod.ts",
		"./http": "./src/lib/http/mod.ts",
		"./openapi": "./src/lib/openapi/mod.ts",
		"./sdk": "./src/lib/sdk/mod.ts",
		"./config": "./src/config/mod.ts",
		"./bus": "./src/lib/bus/mod.ts",
		"./store": "./src/lib/store/mod.ts",
		"./cache": "./src/lib/cache/mod.ts",
		"./storage": "./src/lib/storage/mod.ts",
		"./cli": "./src/cli/main.ts",

		"./providers": "./src/providers/mod.ts",
		"./providers/path": "./src/providers/path.ts",
		"./providers/zod": "./src/providers/zod.ts",
		"./providers/dotenv": "./src/providers/dotenv.ts",
		"./providers/ioredis": "./src/providers/ioredis.ts",
		"./providers/mongodb": "./src/providers/mongodb.ts",
		"./providers/qs": "./src/providers/qs.ts",
		"./providers/jetrouter": "./src/providers/jetrouter.ts",
		"./providers/ua-parser-js": "./src/providers/ua-parser-js.ts",
		"./providers/noble-hashes": "./src/providers/noble-hashes.ts",

		"./logger": "./src/utils/logger.ts",
		"./zod": "./src/providers/zod.ts",
		"./crypto": "./src/utils/crypto.ts",
		"./hash": "./src/utils/hash.ts",
		"./device": "./src/utils/device.ts",
		"./ttl": "./src/utils/ttl.ts",
		"./response": "./src/utils/response.ts",
		"./query": "./src/utils/parseQueryParams.ts"
	},
	"publish": {
		"include": [
			"LICENSE",
			"README.md",
			"mod.ts",
			"src/**/*.ts",
			"deno.json",
			"benchmarks/results/results.json",
			"benchmarks/results/results.md"
		],
		"exclude": [
			"env.example.txt",
			"src/**/*.test.ts",
			"src/**/*.spec.ts",
			"dist/**",
			"tests/"
		]
	},
	"tasks": {
		"lint": "deno lint",
		"lint:fix": "deno lint --fix",
		"format": "deno fmt --watch",
		"format:check": "deno fmt --check",
		"check": "deno check --no-lock mod.ts src/providers/mod.ts src/providers/*.ts src/lib/http/mod.ts src/lib/openapi/mod.ts src/lib/sdk/mod.ts src/config/mod.ts src/lib/bus/mod.ts src/lib/store/mod.ts src/lib/cache/mod.ts src/lib/storage/mod.ts src/utils/*.ts src/cli/main.ts src/cli/plugin.test.ts",
		"test:cli": "deno test --allow-read --allow-write src/cli/plugin.test.ts",
		"test": "deno test --unstable-kv --allow-env --allow-read --allow-net --allow-sys tests/smoke.test.ts tests/jetrouter.test.ts",
		"build": "deno run --allow-read --allow-write=dist --allow-env scripts/build.ts",
		"js:release:prepare": {
			"command": "deno run --allow-read --allow-write=../public scripts/export.ts",
			"dependencies": [
				"check",
				"build"
			]
		},
		"dry-run": {
			"dependencies": [
				"build"
			],
			"command": "deno publish --no-lock --dry-run --allow-dirty"
		},
		"publish": "deno publish"
	},
	"imports": {
		"@std/path": "jsr:@std/path@^1.1.6",
		"@zod/zod": "jsr:@zod/zod@^4.5.4",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.8",
		"ioredis": "npm:ioredis@^6.0.0",
		"mongodb": "npm:mongodb@^7.6.0",
		"qs": "npm:qs@^6.16.0",
		"jetrouter": "npm:jetrouter@0.2.0",
		"ua-parser-js": "npm:ua-parser-js@^2.0.10",
		"@noble/hashes": "npm:@noble/hashes@2.4.0"
	},
	"lint": {
		"include": [
			"./src/",
			"./mod.ts",
			"./scripts/"
		],
		"exclude": [
			"tests/",
			"node_modules/"
		],
		"rules": {
			"tags": ["recommended"],
			"include": [
				"ban-untagged-todo",
				"no-explicit-any",
				"no-non-null-assertion",
				"prefer-as-const",
				"no-unsafe-finally",
				"ban-untagged-ignore",
				"eqeqeq",
				"camelcase",
				"no-eval"
			],
			"exclude": [
				"no-unused-vars",
				"no-console",
				"require-await"
			]
		}
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"indentWidth": 4,
		"semiColons": true,
		"singleQuote": true,
		"proseWrap": "preserve",
		"include": [
			"./src/",
			"./mod.ts",
			"./scripts/"
		],
		"exclude": [
			"tests/",
			"node_modules/"
		]
	},
	"compilerOptions": {
		"lib": ["deno.window", "deno.unstable"],
		"strict": true
	}
}
